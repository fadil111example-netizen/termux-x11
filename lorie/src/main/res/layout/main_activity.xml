<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutDirection="ltr"
        android:paddingLeft="0dp"
        android:paddingTop="0dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp"
        android:background="@android:color/black">

        <com.termux.x11.LorieView
            android:id="@+id/lorieView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            android:layout_gravity="center" />

        <ScrollView
            android:id="@+id/stub"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_stub_gradient"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <ImageView
                    android:id="@+id/x11_image"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:contentDescription="@string/modern_logo_description"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/ic_stub_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/lorie_app_name"
                    android:textColor="#F8FAFC"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/modern_tagline"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_status_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_status" />

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/modern_status_waiting"
                        android:textColor="#86EFAC"
                        android:textSize="13sp" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="160dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#22C55E"
                    android:maxHeight="3dp"
                    android:minHeight="3dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/preferences_button"
                    android:layout_width="72dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:contentDescription="@string/preferences_button_text"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_extra_key_settings"
                        android:tint="#E2E8F0"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/modern_btn_settings"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/displays_button"
                    android:layout_width="72dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:contentDescription="@string/displays_button_text"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lorie_ic_displays"
                        android:tint="#E2E8F0"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/modern_btn_displays"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/help_button"
                    android:layout_width="72dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:contentDescription="@string/help_button_text"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lorie_ic_help"
                        android:tint="#E2E8F0"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/modern_btn_help"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/exit_button"
                    android:layout_width="72dp"
                    android:layout_height="82dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_action_card"
                    android:clickable="true"
                    android:contentDescription="@string/exit_button_text"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/lorie_ic_exit"
                        android:tint="#E2E8F0"
                        tools:ignore="UseAppTint" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/modern_btn_exit"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp" />
                </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_hint_card"
                    android:minWidth="280dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/modern_hint_title"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/modern_hint_caption"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:text="@string/modern_hint_command"
                        android:textColor="#4ADE80"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="@string/modern_tip"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </ScrollView>


    </FrameLayout>

    <LinearLayout
        android:id="@+id/mouse_helper_visibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:translationX="0px"
        android:translationY="0px">

        <Button
            android:id="@+id/button_visibility"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:minWidth="44dip"
            android:minHeight="22dip"
            android:padding="0px"
            android:paddingStart="0px"
            android:paddingLeft="0px"
            android:paddingTop="0px"
            android:paddingEnd="0px"
            android:paddingRight="0px"
            android:paddingBottom="0px"
            android:text="X"
            android:textSize="8sp"
            tools:ignore="HardcodedText,PxUsage,SmallSp" />

        <LinearLayout
            android:id="@+id/mouse_helper_secondary_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:visibility="visible">

            <Button
                android:id="@+id/button_left_click"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="44dip"
                android:minHeight="22dip"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="L"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/button_middle_click"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="44dip"
                android:minHeight="22dip"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="M"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/button_right_click"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:minWidth="44dip"
                android:minHeight="22dip"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="R"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mouse_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:orientation="vertical"
        android:alpha="0.7"
        android:translationX="0px"
        android:translationY="0px">

        <LinearLayout
            android:id="@+id/mouse_buttons_secondary_layer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:visibility="visible">

            <Button
                android:id="@+id/mouse_button_left_click"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="L"
                android:textColor="@android:color/black"
                android:background="@drawable/mouse_buttons"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/mouse_button_middle_click"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="M"
                android:textColor="@android:color/black"
                android:background="@drawable/mouse_buttons"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />

            <Button
                android:id="@+id/mouse_button_right_click"
                android:layout_width="96dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:padding="0px"
                android:paddingStart="0px"
                android:paddingLeft="0px"
                android:paddingTop="0px"
                android:paddingEnd="0px"
                android:paddingRight="0px"
                android:paddingBottom="0px"
                android:text="R"
                android:textColor="@android:color/black"
                android:background="@drawable/mouse_buttons"
                android:textSize="8sp"
                tools:ignore="HardcodedText,PxUsage,SmallSp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/mouse_buttons_position"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:adjustViewBounds="true"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="MOVE"
            android:layout_gravity="center"
            android:background="@drawable/mouse_buttons"
            tools:ignore="HardcodedText,PxUsage,SmallSp" />
    </LinearLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/terminal_toolbar_view_pager"
        android:visibility="gone"
        android:pointerIcon="arrow"
        android:layout_width="match_parent"
        android:layout_height="37.5dp"
        android:background="@drawable/bg_extrakeys_dock"
        android:layoutDirection="ltr"
        android:layout_gravity="bottom|center"/>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:layout_gravity="bottom|center" />
</FrameLayout>
