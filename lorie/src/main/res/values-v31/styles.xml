<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PrivateResource">
    <style name="LorieAppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/lorie_bg</item>
        <item name="android:navigationBarColor">@color/lorie_bg</item>
        <item name="android:windowBackground">@drawable/bg_stub_gradient</item>
        <item name="android:windowSplashScreenBackground">@color/lorie_bg</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/lorie_bg</item>
        <item name="colorAccent">@color/lorie_accent</item>
        <item name="alertDialogTheme">@style/LorieDialogTheme</item>
    </style>
</resources>
