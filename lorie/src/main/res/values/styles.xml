<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="PrivateResource" tools:override="true">
    <style name="LorieAppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/lorie_bg</item>
        <item name="android:navigationBarColor">@color/lorie_bg</item>
        <item name="android:windowBackground">@drawable/bg_stub_gradient</item>
        <item name="colorAccent">@color/lorie_accent</item>
        <item name="alertDialogTheme">@style/LorieDialogTheme</item>
    </style>
    <style name="LorieDialogTheme" parent="@style/Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/lorie_accent</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>
    <style name="LoriePrefsTheme" parent="@style/Theme.AppCompat.DayNight">
        <item name="colorPrimary">@color/lorie_bg_top</item>
        <item name="colorPrimaryDark">@color/lorie_bg</item>
        <item name="colorAccent">@color/lorie_accent_dark</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="android:statusBarColor">@color/lorie_bg</item>
        <item name="android:navigationBarColor">@color/lorie_bg</item>
        <item name="alertDialogTheme">@style/LorieDialogTheme</item>
    </style>
    <style name="Preference.Category.Material">
        <item name="android:layout">@layout/preference_category_material</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
        <item name="singleLineTitle">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.Material">
        <item name="android:layout">@layout/preference_material</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">true</item>
        <item name="singleLineTitle">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/preference_material</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">true</item>
        <item name="singleLineTitle">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.SeekBarPreference.Material">
        <item name="android:layout">@layout/preference_widget_seekbar_material</item>
        <item name="adjustable">true</item>
        <item name="showSeekBarValue">false</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">true</item>
        <item name="singleLineTitle">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.DialogPreference.Material">
        <item name="android:layout">@layout/preference_material</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">true</item>
        <item name="singleLineTitle">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
    <style name="Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:layout">@layout/preference_material</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">true</item>
        <item name="singleLineTitle">false</item>
        <item name="iconSpaceReserved">false</item>
    </style>
</resources>
